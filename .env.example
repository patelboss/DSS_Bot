# ─────────────────────────────────────────────────────────────────────────────
# SDSS Bot — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# On Koyeb: paste these key/value pairs into the "Environment" tab.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get this from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Connection string from Atlas → Connect → Drivers → Python
# Example: mongodb+srv://user:password@cluster0.abcde.mongodb.net/
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=sdss

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL from Supabase → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
# Service Role key (NOT anon key — needed for Storage write)
# Supabase → Settings → API → service_role (keep secret!)
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_BUCKET=raster-layers

# ── COG Layer Filenames in Supabase Bucket ────────────────────────────────────
# These must match the object names you uploaded via data_prep/convert_to_cog.py
COG_FCM=fcm.tif
COG_FTM=ftm.tif
COG_DEM=dem.tif

# ── Application ───────────────────────────────────────────────────────────────
TEMP_DIR=/tmp/sdss
